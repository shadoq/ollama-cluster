# Runtime image of ollama-cluster for NVIDIA DGX Spark (arm64, CUDA 13, GB10).
#
# The payload is built natively on a DGX Spark by scripts/build_cluster_image.sh,
# which stages it as bin/ and lib/ in the build context and builds this file.
# The image is used for both the main Ollama and the worker, so both sides of
# the RPC link always come from one llama.cpp build.
FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libibverbs1 ibverbs-providers \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY bin/ollama /usr/bin/ollama
COPY lib/ollama /usr/lib/ollama
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
